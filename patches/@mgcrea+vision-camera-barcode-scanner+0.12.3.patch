+            case CIQRCodeErrorCorrectionLevelH: ecLevel = @"H"; break;
+          }
+          if (ecLevel) {
+            observationRepresentation[@"errorCorrectionLevel"] = ecLevel;
+          }
+        }
+      }
+    }
   return [observationRepresentation copy];
 }
 
