+    Object cornersObj = barcode.get("cornerPoints");
+    if (cornersObj instanceof List) {
+      List<Object> converted = new ArrayList<>();
+      for (Object pointObj : (List<Object>) cornersObj) {
+        Map<String, Object> point = (Map<String, Object>) pointObj;
+        int[] p = uprightToSensor(((Number) point.get("x")).intValue(),
+                                  ((Number) point.get("y")).intValue(), rotation, w, h);
