+    Object boxObj = barcode.get("boundingBox");
+    if (boxObj instanceof Map) {
+      Map<String, Object> box = (Map<String, Object>) boxObj;
+      int[] a = uprightToSensor(((Number) box.get("left")).intValue(),
+                                ((Number) box.get("top")).intValue(), rotation, w, h);
+      int[] b = uprightToSensor(((Number) box.get("right")).intValue(),
+                                ((Number) box.get("bottom")).intValue(), rotation, w, h);
+      Map<String, Object> mapped = new java.util.HashMap<>();
