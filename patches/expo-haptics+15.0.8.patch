+    // 앱에서 세기·패턴을 직접 정하는 진동 (기본 impact/notification은 진폭이 30~70/255로 너무 약하다)
+    AsyncFunction("vibrateWaveformAsync") { timings: List<Long>, amplitudes: List<Int> ->
+      if (timings.isEmpty() || timings.size != amplitudes.size) return@AsyncFunction
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+        val amps = amplitudes.map { it.coerceIn(0, 255) }.toIntArray()
